# Laya HTTP server configuration
# CPU-only deployment, optimised for Spanish traffic

# Device: CPU (no GPU)
LAYA_DEVICE=cpu

# Preload checkpoints at startup so the first request is fast
LAYA_PRELOAD=1

# Only load the multilingual checkpoint (Spanish routes here)
LAYA_MODELS=multilingual

# Spanish traffic: default to multilingual so ambiguous short texts also route correctly
LAYA_DEFAULT_MODEL=multilingual

# Keep only 1 checkpoint resident (we only need multilingual)
LAYA_MAX_LOADED=1

# CPU threads — use 8 of the 32 available cores (good balance for ~8 GB RAM budget)
LAYA_THREADS=8
OMP_NUM_THREADS=8

# Listen on all interfaces so the server is reachable from outside
LAYA_BIND_ADDRESS=0.0.0.0
LAYA_HOST=0.0.0.0
LAYA_PORT=9000

# Log level
LAYA_LOG_LEVEL=info
